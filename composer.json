{
  "name": "benlk/engage-columbus-scrape-to-rss",
  "description": "Daily Engage Columbus sitemap scraper that stores new URLs in CSV and publishes RSS.",
  "type": "project",
  "license": "Unlicense",
  "require": {
    "php": ">=8.5",
    "league/commonmark": "^2.7"
  },
  "require-dev": {
    "10up/phpcs-composer": "^3.0"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
		"lint": [
			"phpcs -s ."		],
		"lint-fix": [
			"phpcbf ."
		],
		"lint-changed": [
			"phpcs $(git diff --name-only --diff-filter=ACMRU HEAD | grep \\.php$)"
    ],
    "build": [
      "mkdir -p _site",
      "php index.php > _site/index.html",
      "cp feed.xml style.css _site/"
    ]
	}
}
